{
  "name": "@thaumic-cast/ui",
  "version": "4.0.1",
  "private": true,
  "author": {
    "name": "Brew",
    "url": "https://thisisbrew.com/"
  },
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./tokens": "./src/tokens.ts",
    "./layers.css": "./src/layers.css",
    "./tokens.css": "./src/tokens.css",
    "./webkit-fallbacks.css": "./src/webkit-fallbacks.css",
    "./fonts.css": "./src/fonts.css",
    "./base.css": "./src/base.css",
    "./motion.css": "./src/motion.css",
    "./utilities.css": "./src/utilities.css"
  },
  "scripts": {
    "build": "echo 'No build step (consumed as TS source)'",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf catalogue/dist catalogue/test-results catalogue/playwright-report catalogue/blob-report",
    "test": "bun test src scripts",
    "tokens": "bun scripts/generate-tokens.ts",
    "tokens:check": "bun scripts/generate-tokens.ts --check",
    "catalogue": "vite --config catalogue/vite.config.ts",
    "catalogue:lan": "vite --config catalogue/vite.config.ts --host 0.0.0.0 --port 4180 --strictPort",
    "catalogue:build": "vite build --config catalogue/vite.config.ts",
    "test:catalogue": "playwright test --config catalogue/playwright.config.ts"
  },
  "peerDependencies": {
    "@thaumic-cast/protocol": "workspace:*",
    "@thaumic-cast/shared": "workspace:*",
    "preact": "~10.28.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@preact/preset-vite": "^2.10.5",
    "@thaumic-cast/protocol": "workspace:*",
    "@thaumic-cast/shared": "workspace:*",
    "preact": "~10.28.4",
    "prettier": "^3.7.4",
    "typescript": "^7.0.2",
    "vite": "^8.0.8"
  }
}
