+// ─────────────────────────────────────────────────────────────────────────────
+// WAV Utilities (PCM diagnostic capture)
+// ─────────────────────────────────────────────────────────────────────────────
+
+/**
+ * Writes an ASCII string into a DataView at the given offset.
+ * @param view - DataView to write into
+ * @param offset - Byte offset
+ * @param str - ASCII string to write
+ */
+function writeString(view: DataView, offset: number, str: string): void {
+  for (let i = 0; i < str.length; i++) {
+    view.setUint8(offset + i, str.charCodeAt(i));
+  }
+}
+
+/**
+ * Creates a 44-byte RIFF/WAV header.
+ * @param sampleRate - Audio sample rate in Hz
+ * @param channels - Number of audio channels
+ * @param bitsPerSample - Bits per sample (16 or 32)
+ * @param dataSize - Size of the PCM data in bytes
+ * @param formatTag - WAV format tag (1 = PCM Int16, 3 = IEEE Float32)
+ * @returns A 44-byte ArrayBuffer containing the WAV header
+ */
+function createWavHeader(
+  sampleRate: number,
+  channels: number,
+  bitsPerSample: number,
+  dataSize: number,
+  formatTag: number,
+): ArrayBuffer {
+  const header = new ArrayBuffer(44);
+  const view = new DataView(header);
+
+  writeString(view, 0, 'RIFF');
+  view.setUint32(4, 36 + dataSize, true);
+  writeString(view, 8, 'WAVE');
+
+  writeString(view, 12, 'fmt ');
+  view.setUint32(16, 16, true);
+  view.setUint16(20, formatTag, true);
+  view.setUint16(22, channels, true);
+  view.setUint32(24, sampleRate, true);
+  view.setUint32(28, sampleRate * channels * (bitsPerSample / 8), true);
+  view.setUint16(32, channels * (bitsPerSample / 8), true);
+  view.setUint16(34, bitsPerSample, true);
+
+  writeString(view, 36, 'data');
+  view.setUint32(40, dataSize, true);
+
+  return header;
+}
+
+/**
+ * Triggers a WAV file download in the offscreen document.
+ * @param header - 44-byte WAV header
+ * @param data - Raw PCM data
+ * @param filename - Download filename
+ */
+function downloadWav(header: ArrayBuffer, data: ArrayBuffer, filename: string): void {
+  const blob = new Blob([header, data], { type: 'audio/wav' });
+  const url = URL.createObjectURL(blob);
+  const a = document.createElement('a');
+  a.href = url;
+  a.download = filename;
+  a.click();
+  // Defer revocation — click() triggers download asynchronously
+  setTimeout(() => URL.revokeObjectURL(url), 10_000);
+}
+
 /** Maximum number of parallel capture sessions allowed in offscreen. */
 export const MAX_OFFSCREEN_SESSIONS = 10;
 
